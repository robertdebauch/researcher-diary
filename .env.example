# Ключ CARTO для тайлов карты (https://carto.com/basemaps)
#   .env.development — npm run dev      (ключ, разрешённый для localhost)
#   .env.production  — npm run build    (ключ, разрешённый для robertdebauch.github.io)
#   .env             — общие переменные, без секретов
# Без ключа приложение работает на тайлах OSM.
VITE_CARTO_API_KEY=
